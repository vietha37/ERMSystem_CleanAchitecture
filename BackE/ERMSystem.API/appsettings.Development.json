{
  "AiSymptomChat": {
    "Enabled": true,
    "Provider": "Ollama",
    "BaseUrl": "http://localhost:11434",
    "GeneratePath": "/api/generate",
    "Model": "llama3.1:8b",
    "TimeoutSeconds": 60,
    "MaxInputCharacters": 1200,
    "RateLimit": {
      "PermitLimit": 8,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
